# -----------------------------------------------------------------------------
# MERCADO PAGO — Checkout Pro + Split de Pagos (Marketplace Producción)
# Obtener en: https://www.mercadopago.com.ar/developers/panel
# -----------------------------------------------------------------------------
# Clave pública (frontend)
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-1a7eedf3-ac96-443e-a6e2-6049290a711e

# Access Token privado (backend)
MP_ACCESS_TOKEN=APP_USR-3082023901451356-061522-0ec7574c653680e1e473740fc4623a23-3469091946

# Para el flujo OAuth 2.0 de choferes y pasajeros (MP Connect / Marketplace)
MP_CLIENT_ID=3082023901451356
MP_CLIENT_SECRET=V1F4LXgHRKKiYl4QVlJhrUASuJJv1mYz

# URL de retorno OAuth (debe coincidir con la configurada en MP Dashboard)
MP_OAUTH_REDIRECT_URI=http://localhost:3000/api/mp/oauth/callback

# Clave de firma criptográfica para seguridad de Webhooks
MP_WEBHOOK_SECRET=ebd396063d34c704291eeba5b91a0dc0585cc86b4a2704cf47073486e81e30e7


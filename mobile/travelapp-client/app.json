{
  "expo": {
    "name": "TravelApp",
    "owner": "fer-travelapps-team",
    "slug": "travelapp-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-bg.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#0B192C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.travelapp.client",
      "config": {
        "googleMapsApiKey": "AIzaSyD4XIT5MNfECRy6wQe8BNgBb9pWC6lsr9U"
      }
    },
    "android": {
      "splash": {
        "image": "./assets/splash-bg.jpg",
        "resizeMode": "cover",
        "backgroundColor": "#0B192C"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B192C"
      },
      "package": "ar.travelapp.client",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD4XIT5MNfECRy6wQe8BNgBb9pWC6lsr9U"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TravelApp necesita tu ubicación para mostrarte conductores cercanos y calcular rutas."
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyD4XIT5MNfECRy6wQe8BNgBb9pWC6lsr9U"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a687d59f-c1ec-4f94-b77f-eea980284d82"
      }
    }
  }
}

        "googleMapsApiKey": "AIzaSyD4XIT5MNfECRy6wQe8BNgBb9pWC6lsr9U"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TravelApp Conductor necesita tu ubicación para recibir viajes cercanos y navegar hacia el pasajero.",
